+/**
+ * 把单个字形渲染成「模糊光团」位图：位图按字形的实际包围盒外扩模糊半径开板，
+ * 在**软件位图**上用 BlurMaskFilter 画字形 → 只有字形所在像素有颜色、框内其余像素全透明。
+ * 这样落到屏幕上的光晕永远贴笔画，不会出现矩形底。
+ */
+private data class GlowTile(val bitmap: android.graphics.Bitmap, val left: Float, val top: Float)
+
+private fun renderGlowTile(glyph: android.graphics.Path, radiusPx: Float, argb: Int): GlowTile? {
+    val bounds = android.graphics.RectF()
+    glyph.computeBounds(bounds, true)
+    if (bounds.isEmpty || bounds.width() <= 0f || bounds.height() <= 0f) return null
+    val pad = radiusPx * 2f + 2f
+    val left = kotlin.math.floor(bounds.left - pad).toInt()
+    val top = kotlin.math.floor(bounds.top - pad).toInt()
+    val width = kotlin.math.ceil(bounds.width() + pad * 2f).toInt().coerceAtLeast(1)
+    val height = kotlin.math.ceil(bounds.height() + pad * 2f).toInt().coerceAtLeast(1)
+    if (width > 2048 || height > 2048) return null
+    val bitmap = android.graphics.Bitmap.createBitmap(
+        width,
+        height,
+        android.graphics.Bitmap.Config.ARGB_8888,
+    )
+    val canvas = android.graphics.Canvas(bitmap)
+    canvas.translate(-left.toFloat(), -top.toFloat())
+    val paint = android.graphics.Paint().apply {
+        isAntiAlias = true
+        style = android.graphics.Paint.Style.FILL
+        color = argb
+        maskFilter = android.graphics.BlurMaskFilter(radiusPx, android.graphics.BlurMaskFilter.Blur.NORMAL)
+    }
+    canvas.drawPath(glyph, paint)
+    return GlowTile(bitmap, left.toFloat(), top.toFloat())
+}
+
+/**
+ * 真正的「沿路径模糊」：CPU 端逐像素算「到最近笔画的距离」再取高斯权，不吃平台模糊实现。
+ *
+ * 为什么必须自己算：Android 的 `BlurMaskFilter` 只在「有 alpha 通道的软件位图」上才只模糊形状，
+ * 画到硬件加速画布（Compose 的 Canvas 就是）时会被降级成「实心矩形 + 模糊」；模拟器 GPU 上
+ * 实测就是这样出生的矩形底 —— 跟 Robolectric 无关。这里用 [android.graphics.PathMeasure]
+ * 沿字形路径重采样出笔画折线，再对位图每个像素求最近折点距离，得到只贴笔画的圆形光晕。
+ *
+ * @param maxRadiusPx 光晕最大半径（像素）；距离超过 1.8 倍的像素直接跳过（alpha 已不可见）。
+ */
+private fun renderHaloTile(glyph: android.graphics.Path, maxRadiusPx: Float, argb: Int): GlowTile? {
+    val bounds = android.graphics.RectF()
+    glyph.computeBounds(bounds, true)
+    if (bounds.isEmpty || bounds.width() <= 0f || bounds.height() <= 0f) return null
+    val pad = maxRadiusPx * 1.8f + 2f
+    val left = kotlin.math.floor(bounds.left - pad).toInt()
+    val top = kotlin.math.floor(bounds.top - pad).toInt()
+    val width = kotlin.math.ceil(bounds.width() + pad * 2f).toInt().coerceAtLeast(1)
+    val height = kotlin.math.ceil(bounds.height() + pad * 2f).toInt().coerceAtLeast(1)
+    if (width > 1024 || height > 1024) return null
+
+    // 1. 沿路径重采样出笔画折线（步长 ≤ 1.2px，保证笔画的细横竖都被采到）。
+    val measure = android.graphics.PathMeasure(glyph, false)
+    val length = measure.length
+    if (length <= 0f) return null
+    val samples = (length / SAMPLE_STEP_PX).toInt().coerceIn(8, 6000) + 1
+    val xs = FloatArray(samples)
+    val ys = FloatArray(samples)
+    val pos = FloatArray(2)
+    for (i in 0 until samples) {
+        measure.getPosTan(length * i / (samples - 1), pos, null)
+        xs[i] = pos[0]
+        ys[i] = pos[1]
+    }
+
+    // 2. 逐像素求最近距离 → 高斯权（sigma = 半径/3.2）。收窄是必须的：sigma 太宽时相邻字的
+    //    光团在高亮瞬间会连成一整片深色块（审图第 3 条的反面），Folia 的 drop-shadow
+    //    半径本身也只到 0.4×文字阴影半径。
+    val sigma = (maxRadiusPx / 2.4f).coerceAtLeast(0.30f)
+    val twoSigma2 = 2f * sigma * sigma
+    val limit = maxRadiusPx * 2.5f
+    val limit2 = limit * limit
+    val alpha = android.graphics.Color.alpha(argb)
+    val red = android.graphics.Color.red(argb)
+    val green = android.graphics.Color.green(argb)
+    val blue = android.graphics.Color.blue(argb)
+    val pixels = IntArray(width * height)
+    for (py in 0 until height) {
+        val wy = (top + py + 0.5f)
+        for (px in 0 until width) {
+            val wx = (left + px + 0.5f)
+            var best = Float.MAX_VALUE
+            var i = 0
+            while (i < samples) {
+                val dx = xs[i] - wx
+                val dy = ys[i] - wy
+                val d2 = dx * dx + dy * dy
+                if (d2 < best) best = d2
+                if (best <= 0.25f) break
+                i++
+            }
+            if (best > limit2) continue
+            val a = (alpha * kotlin.math.exp(-best / twoSigma2)).toInt().coerceIn(0, 255)
+            if (a <= 2) continue
+            pixels[py * width + px] = android.graphics.Color.argb(a, red, green, blue)
+        }
+    }
+    val bitmap = android.graphics.Bitmap.createBitmap(width, height, android.graphics.Bitmap.Config.ARGB_8888)
+    bitmap.setPixels(pixels, 0, width, 0, 0, width, height)
+    return GlowTile(bitmap, left.toFloat(), top.toFloat())
+}
+
+/** 字形路径重采样步长（像素）：越小越贴合笔画，越大越省 CPU。 */
+private const val SAMPLE_STEP_PX = 1.2f
+
